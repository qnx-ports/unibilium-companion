# Alpine-Maintainer: Celeste <cielesti@protonmail.com>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=unibilium
pkgver=2.1.1
pkgrel=${pkgrel:-0}
pkgdesc="Terminfo parsing library"
url="https://github.com/neovim/unibilium"
arch="all"
license="LGPL-3.0-or-later"
makedepends="libtool perl"
checkdepends="perl"
subpackages="$pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/neovim/unibilium/archive/v$pkgver.tar.gz"

build() {
    make PREFIX=/usr CC=gcc CFLAGS+=-D_QNX_SOURCE
}

check() {
    make test
}

package() {
    make PREFIX=/usr DESTDIR="$pkgdir" install
}


options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
